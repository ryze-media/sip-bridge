; ============================================
; GLOBAL
; ============================================

[global]
type=global
user_agent=sipgate sip-bridge/1.0.1

; ============================================
; TRANSPORTS
; ============================================

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_media_address=${EXTERNAL_IP}
external_signaling_address=${EXTERNAL_IP}
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060
external_media_address=${EXTERNAL_IP}
external_signaling_address=${EXTERNAL_IP}
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

[transport-tls]
type=transport
protocol=tls
bind=0.0.0.0:5061
verify_server=no
external_media_address=${EXTERNAL_IP}
external_signaling_address=${EXTERNAL_IP}
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

[transport-sipgate-tls]
type=transport
protocol=tls
bind=0.0.0.0:5062
method=tlsv1_2
verify_server=yes
ca_list_file=/etc/ssl/certs/ca-certificates.crt
allow_reload=yes
external_media_address=${EXTERNAL_IP}
external_signaling_address=${EXTERNAL_IP}
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

; ============================================
; SIPGATE TRUNK (inbound)
; ============================================

[sipgate]
type=registration
transport=transport-sipgate-tls
outbound_auth=sipgate-auth
server_uri=sip:${SIPGATE_USER}@${SIPGATE_REGISTRAR}\;transport=tls
client_uri=sip:${SIPGATE_USER}@${SIPGATE_REGISTRAR}
contact_user=${SIPGATE_USER}
support_outbound=yes
support_path=yes
line=yes
endpoint=sipgate-endpoint
expiration=3600
retry_interval=60
forbidden_retry_interval=60
fatal_retry_interval=60
auth_rejection_permanent=no
max_retries=10

[sipgate-auth]
type=auth
auth_type=userpass
username=${SIPGATE_USER}
password=${SIPGATE_PASS}

[sipgate-endpoint]
type=endpoint
transport=transport-sipgate-tls
context=from-sipgate
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes
disallow=all
allow=alaw
from_domain=${SIPGATE_REGISTRAR}

[sipgate-identify]
type=identify
endpoint=sipgate-endpoint
match=217.10.64.0/20
match=217.10.68.0/24
match=217.116.112.0/20

; ============================================
; LIVEKIT (outbound)
; ============================================

[livekit]
type=endpoint
transport=transport-${LIVEKIT_SIP_TRANSPORT}
context=from-livekit
outbound_auth=livekit-auth
aors=livekit-aor
direct_media=no
disallow=all
allow=alaw
from_domain=${LIVEKIT_SIP_HOST}

[livekit-auth]
type=auth
auth_type=userpass
username=${LIVEKIT_SIP_USER}
password=${LIVEKIT_SIP_PASS}

[livekit-aor]
type=aor
contact=sip:${LIVEKIT_SIP_HOST}:${LIVEKIT_SIP_PORT}\;transport=${LIVEKIT_SIP_TRANSPORT}
qualify_frequency=30
