# === Server ===
# Public IP of your server (required for RTP to work behind Docker NAT)
EXTERNAL_IP=1.2.3.4

# === sipgate Credentials ===
SIPGATE_USER=1234567t0
SIPGATE_PASS=your-sipgate-password
SIPGATE_REGISTRAR=sip.sipgate.com

# === LiveKit SIP target ===
# Find the exact global or region-pinned endpoint in LiveKit Cloud.
LIVEKIT_SIP_HOST=your-project.sip.livekit.cloud
LIVEKIT_SIP_PORT=5060
LIVEKIT_SIP_TRANSPORT=tcp

# Match the credentials configured on the LiveKit inbound trunk.
LIVEKIT_SIP_USER=replace-me
LIVEKIT_SIP_PASS=replace-me

# Used to normalize national numbers such as 0211... to E.164.
DEFAULT_COUNTRY_CODE=49
